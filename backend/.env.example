# Local development: SQLite requires no server installation.
DATABASE_URL=sqlite:///./data/startup_support.db
# Production PostgreSQL example (do not commit real passwords):
# DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@localhost:5432/startup_support
# Never prefix server secrets with VITE_.

# Local optional AI extraction (never commit .env or API keys).
# AI_MATCH_MODE=off (default): original frontend contract, deterministic search demo.
# AI_MATCH_MODE=demo: uses standalone offline rules; NOT a true AI decision.
# AI_MATCH_MODE=llm: makes real API calls per frontend search (billable).
AI_MATCH_MODE=off
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Public LLM endpoints require explicit opt-in AND your own auth/rate limits.
ENABLE_PUBLIC_LLM=false
